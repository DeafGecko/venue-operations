---
// src/pages/admin/calendar.astro
// Calendar View – shows all bookings on a monthly grid

import AdminLayout from '../../layouts/AdminLayout.astro';
import { sanityClient } from '../../lib/sanity';
import CalendarGrid from '../../components/admin/CalendarGrid';
import { 
      Calendar,
      PartyPopper,
      Users,
      MapPin,
      Clock,
      AlertCircle
} from 'lucide-react';

// Fetch all bookings
const bookings = await sanityClient.fetch(`
  *[_type == "booking"] {
            "clientName": coalesce(*[_id == ^.clientId][0].name, clientName),
      "email": coalesce(*[_id == ^.clientId][0].email, email),
      "phone": coalesce(*[_id == ^.clientId][0].phone, phone),
      clientId,
_id,
      accountNumber,
      eventDate,
      paymentStatus,
      bookingType,
      assignedSpace,
      guestCount,
      eventType,
      startTime,
      endTime,
      totalPrice,
      amountPaid
      }
`);

// Format dates for the calendar
const formattedBookings = bookings.map((b: any) => ({
      ...b,
      eventDate: new Date(b.eventDate).toISOString(),
}));
---

<AdminLayout title="Calendar">
      <CalendarGrid client:load bookings={formattedBookings} />
</AdminLayout>