---
// src/pages/admin/login.astro
import { sanityClient } from '../../lib/sanity';

// ── Fetch settings for dynamic branding ──
let settings;
try {
  settings = await sanityClient.fetch(`*[_type == "settings"][0]`);
} catch {
  settings = null;
}

const logoUrl = settings?.logo?.asset?.url || '/logo.svg';
const sidebarColor = settings?.sidebarColor || '#1A1816';
const primaryColor = settings?.primaryColor || '#A03A3A';
const venueName = settings?.venueName || 'Venue Operations';

const error = Astro.url.searchParams.get('error');
const resetSuccess = Astro.url.searchParams.get('reset');
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Login · {venueName}</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz@14..32&display=swap" rel="stylesheet" />

  <style define:vars={{
    sidebarBg: sidebarColor,
    primary: primaryColor,
  }}>
    body {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      background: var(--sidebarBg);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      margin: 0;
      padding: 1rem;
    }

    .back-wrap {
      position: fixed;
      top: 1rem;
      left: calc(1rem + 20px);
      z-index: 10;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: #ffffff;
      font-size: 0.9rem;
      text-decoration: none;
      padding: 0.35rem 0;
    }

    .back-link:hover,
    .back-link:focus-visible {
      text-decoration: underline;
      outline: none;
    }

    .login-box {
      background: #ffffff;
      padding: 2.5rem 2.8rem;
      max-width: 420px;
      width: 100%;
      border-radius: 16px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.15);
      text-align: center;
    }

    .logo {
      max-height: 48px;
      width: auto;
      margin-bottom: 1.5rem;
    }

    h1 {
      font-size: 1.5rem;
      font-weight: 400;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      margin: 0 0 0.25rem 0;
      color: #1a1a1a;
    }

    .sub {
      font-size: 0.8rem;
      color: #6b6b70;
      margin-bottom: 1.75rem;
    }

    .field-error {
      color: #b91c1c;
      font-size: 0.8rem;
      text-align: left;
      margin: -0.9rem 0 1rem;
    }

    .error {
      color: #b91c1c;
      font-size: 0.85rem;
      margin-bottom: 1rem;
      padding: 0.5rem 0.75rem;
      background: #fee2e2;
      border-radius: 6px;
      text-align: left;
    }

    .success {
      color: #065f46;
      font-size: 0.85rem;
      margin-bottom: 1rem;
      padding: 0.5rem 0.75rem;
      background: #d1fae5;
      border-radius: 6px;
      text-align: left;
    }

    label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: #555;
      margin-bottom: 0.25rem;
      text-align: left;
    }

    input {
      width: 100%;
      border: 1px solid #d0d0d0;
      padding: 0.75rem 1rem;
      margin-bottom: 1.25rem;
      border-radius: 8px;
      font-size: 0.95rem;
      transition: border-color 0.15s;
      background: #fafaf9;
      box-sizing: border-box;
    }

    input:focus {
      outline: none;
      border-color: var(--primary);
      background: #fff;
    }

    button {
      width: 100%;
      background: var(--primary);
      color: white;
      border: none;
      padding: 0.8rem;
      border-radius: 8px;
      font-size: 0.9rem;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s;
    }

    button:hover {
      opacity: 0.85;
    }

    .forgot-link {
      margin-top: 0.5rem;
      text-align: right;
    }

    .forgot-link a {
      font-size: 0.8rem;
      color: var(--primary);
      text-decoration: none;
    }

    .forgot-link a:hover {
      text-decoration: underline;
    }

    .footer-text {
      margin-top: 1.5rem;
      font-size: 0.7rem;
      color: #6b6157;
      text-align: center;
    }
  </style>
</head>
<body>

  <div class="back-wrap">
    <a href="/book" id="back-link" class="back-link">
      <span aria-hidden="true">←</span> Back
    </a>
  </div>

  <div class="login-box">
    <img src={logoUrl} alt="{venueName} logo" class="logo" />

    <h1>Admin Login</h1>
    <p class="sub">Enter your credentials to access the admin panel</p>

    {error && <p class="error">{error === '1' ? 'Invalid email or password.' : error}</p>}
    {resetSuccess && <p class="success">Your password has been reset. Please log in.</p>}

    <form method="POST" action="/api/admin/auth" id="login-form" novalidate>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="admin@venue.com" required aria-describedby="email-err" />
      <p class="field-error" id="email-err" role="alert" hidden></p>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" placeholder="••••••••" required aria-describedby="password-err" />
      <p class="field-error" id="password-err" role="alert" hidden></p>

      <button type="submit">Log In</button>
    </form>
    <script is:inline>
      // Our own validation messages, instead of the browser's pop-up bubbles.
      (() => {
        const form = document.getElementById("login-form");
        const email = document.getElementById("email");
        const password = document.getElementById("password");
        const emailErr = document.getElementById("email-err");
        const passwordErr = document.getElementById("password-err");
        const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        const show = (input, box, message) => {
          box.textContent = message;
          box.hidden = !message;
          input.setAttribute("aria-invalid", message ? "true" : "false");
        };

        form.addEventListener("submit", (e) => {
          const emailValue = email.value.trim();
          const emailMessage = !emailValue ? "Enter your email address."
            : !EMAIL.test(emailValue) ? "Enter a valid email address, like name@example.com."
            : "";
          const passwordMessage = password.value ? "" : "Enter your password.";
          show(email, emailErr, emailMessage);
          show(password, passwordErr, passwordMessage);
          if (emailMessage || passwordMessage) {
            e.preventDefault();
            (emailMessage ? email : password).focus();
          }
        });
        email.addEventListener("input", () => show(email, emailErr, ""));
        password.addEventListener("input", () => show(password, passwordErr, ""));
      })();
    </script>

    <div class="forgot-link">
      <a href="/admin/forgot-password">Forgot password?</a>
    </div>

    <div class="footer-text">
      {venueName} · v1.0
    </div>
  </div>

  <script is:inline>
    // Back goes to the page the user came from; with no history, it goes to the booking page.
    document.getElementById("back-link")?.addEventListener("click", (e) => {
      if (window.history.length > 1) {
        e.preventDefault();
        window.history.back();
      }
    });
  </script>
</body>
</html>