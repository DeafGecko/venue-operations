---
import {
  ArrowUpRight,
  CalendarCheck,
  CalendarDays,
  CheckCircle2,
  CircleAlert,
  Clock3,
  DollarSign,
  MapPin,
  TrendingUp,
  Users,
  Activity,
} from "lucide-react";
import DashboardCharts from "../components/demo/DemoDashboardCharts";
import { demoBookings, monthlyRevenue, revenueSlices } from "../data/demoVenue";
import AdminLayout from "../layouts/AdminLayout.astro";

const augustBookings = demoBookings.filter((b) => b.eventDate.startsWith("2026-08"));
const todayEvents = augustBookings.filter((b) => b.eventDate.startsWith("2026-08-25"));
const upcomingEvents = augustBookings
  .filter((b) => b.eventDate >= "2026-08-25")
  .slice(0, 4);
const recentBookings = [...demoBookings]
  .sort((a, b) => b.accountNumber.localeCompare(a.accountNumber))
  .slice(0, 5);

const stats = [
  { label: "Revenue",  value: "$184,750", change: "+14.8%", detail: "vs. last period",     icon: DollarSign,   iconBg: "bg-emerald-50",  iconColor: "text-emerald-600" },
  { label: "Bookings", value: "86",        change: "+9",     detail: "net new this month",  icon: CalendarDays, iconBg: "bg-sky-50",       iconColor: "text-sky-600"     },
  { label: "Upcoming", value: "14",        change: "92%",    detail: "average readiness",   icon: CalendarCheck,iconBg: "bg-violet-50",    iconColor: "text-violet-600"  },
  { label: "Clients",  value: "63",        change: "+11.2%", detail: "returning rate",      icon: Users,        iconBg: "bg-amber-50",     iconColor: "text-amber-600"   },
];
const statusCounts = { paid: 58, partial: 19, unpaid: 9 };

const actionItems = [
  { title: "Final payment overdue",     detail: "Lumen Foundation · $18,600",          tone: "rose",  due: "Today"   },
  { title: "Confirm vendor load-in",    detail: "Summer Vendor Market · Courtyard",     tone: "amber", due: "2 days"  },
  { title: "Approve revised floor plan",detail: "Aperture Studio · Gallery",            tone: "blue",  due: "3:00 PM" },
];
---

<AdminLayout
  title="Dashboard"
  subtitle="Revenue, readiness, and today's venue operations"
  badge="Demo"
  demo
>
  <!-- Live status banner -->
  <section class="mb-4 border-l-3 border-[#111827] bg-white px-4 py-3 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="relative flex h-2.5 w-2.5 shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <div>
          <p class="text-[0.6rem] font-semibold uppercase tracking-widest text-[#6b7280]">Tuesday, August 25</p>
          <p class="mt-0.5 text-sm font-medium text-[#111827]">
            Operations on track — one event live, three items need attention.
          </p>
        </div>
      </div>
      <a
        href="/demo/calendar"
        class="inline-flex items-center gap-2 rounded-md border border-[#d1d5db] px-3 py-2 text-xs font-medium text-[#374151] hover:bg-[#f9fafb] transition"
      >
        Open calendar
        <ArrowUpRight className="w-3.5 h-3.5" aria-hidden="true" />
      </a>
    </div>
  </section>

  <!-- KPI cards -->
  <section class="grid grid-cols-2 xl:grid-cols-4 gap-3 mb-4" aria-label="Business overview">
    {stats.map(({ label, value, change, detail, icon: Icon, iconBg, iconColor }) => (
      <article class="bg-white border border-[#e5e7eb] rounded-xl p-4 shadow-sm">
        <div class="flex items-start justify-between gap-2">
          <p class="text-[0.6rem] font-semibold uppercase tracking-widest text-[#9ca3af]">{label}</p>
          <span class={`w-8 h-8 rounded-lg ${iconBg} flex items-center justify-center shrink-0 ${iconColor}`}>
            <Icon className="w-4 h-4" aria-hidden="true" />
          </span>
        </div>
        <p class="mt-2 text-2xl font-semibold text-[#111827] leading-none">{value}</p>
        <div class="mt-3 flex items-center gap-1.5 text-[0.6rem]">
          <span class="font-semibold text-emerald-600">{change}</span>
          <span class="text-[#9ca3af]">{detail}</span>
        </div>
      </article>
    ))}
  </section>

  <!-- Charts + action queue -->
  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.6fr)_minmax(18rem,0.7fr)] gap-4 mb-4">
    <section class="min-w-0 h-full">
      <DashboardCharts
        monthly={monthlyRevenue}
        statusCounts={statusCounts}
        revenueSlices={revenueSlices}
        client:load
      />
    </section>

    <section class="bg-white border border-[#e5e7eb] rounded-xl shadow-sm overflow-hidden">
      <header class="px-4 py-3 flex items-center justify-between">
        <div>
          <p class="text-[0.6rem] font-semibold uppercase tracking-widest text-[#9ca3af]">Action queue</p>
          <p class="mt-0.5 text-xs text-[#6b7280]">Priority exceptions</p>
        </div>
        <span class="w-7 h-7 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
          <CircleAlert className="w-4 h-4" />
        </span>
      </header>
      <ul>
        {actionItems.map((item, i) => (
          <li data-fake-delete class="px-4 py-3 flex items-start gap-3" style={i > 0 ? "border-top: 1px solid var(--admin-border);" : ""}>
            <span
              class:list={[
                "mt-1.5 w-2 h-2 rounded-full shrink-0",
                item.tone === "rose" ? "bg-rose-500" : item.tone === "amber" ? "bg-amber-500" : "bg-blue-500",
              ]}
            />
            <div class="min-w-0 flex-1">
              <p class="text-xs font-semibold text-[#111827]">{item.title}</p>
              <p class="mt-0.5 text-[0.6rem] text-[#9ca3af] truncate">{item.detail}</p>
            </div>
            <span class="text-[0.55rem] font-medium text-[#6b7280] shrink-0">{item.due}</span>
          </li>
        ))}
      </ul>
      <div class="px-4 py-3 bg-[#fafafa] flex items-center gap-2 text-[0.6rem] text-[#6b7280]" style="border-top: 1px solid var(--admin-border);">
        <CheckCircle2 className="w-3.5 h-3.5 text-emerald-500" />
        12 tasks completed this week
      </div>
    </section>
  </div>

  <!-- Upcoming readiness + today at the venue -->
  <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-4 mb-4">
    <section class="bg-white border border-[#e5e7eb] rounded-xl shadow-sm overflow-hidden">
      <header class="px-4 py-3 flex items-center justify-between gap-3">
        <div>
          <p class="text-[0.6rem] font-semibold uppercase tracking-widest text-[#9ca3af]">Upcoming readiness</p>
          <p class="mt-0.5 text-xs text-[#6b7280]">Next four events across the venue</p>
        </div>
        <TrendingUp className="w-4 h-4 text-[#9ca3af]" aria-hidden="true" />
      </header>
      <div>
        {upcomingEvents.map((event, i) => (
          <article data-fake-delete class="px-4 py-3 grid grid-cols-[minmax(0,1fr)_5rem] gap-4 items-center" style={i > 0 ? "border-top: 1px solid var(--admin-border);" : ""}>
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <p class="text-xs font-semibold text-[#111827] truncate">{event.eventName}</p>
                <span class="text-[0.55rem] text-[#9ca3af] shrink-0">
                  {new Date(event.eventDate).toLocaleDateString("en-US", { month: "short", day: "numeric" })}
                </span>
              </div>
              <p class="mt-1 text-[0.6rem] text-[#9ca3af] flex items-center gap-1">
                <MapPin className="w-3 h-3" />
                {event.assignedSpace} · {event.guestCount} guests
              </p>
            </div>
            <div>
              <div class="flex justify-between text-[0.55rem] text-[#6b7280] mb-1">
                <span>Ready</span>
                <span class={event.readiness >= 85 ? "text-emerald-600" : event.readiness >= 70 ? "text-amber-600" : "text-rose-600"}>
                  {event.readiness}%
                </span>
              </div>
              <div class="h-1.5 rounded-full bg-[#e5e7eb] overflow-hidden">
                <div
                  class:list={[
                    "h-full rounded-full",
                    event.readiness >= 85 ? "bg-emerald-500" : event.readiness >= 70 ? "bg-amber-500" : "bg-rose-500",
                  ]}
                  style={`width: ${event.readiness}%`}
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Today at the venue — accent dark card (intentionally dark as a visual anchor) -->
    <section class="bg-[#111827] text-white rounded-xl shadow-sm overflow-hidden">
      <header class="px-4 py-3 border-b border-white/10 flex items-center justify-between">
        <div>
          <p class="text-[0.6rem] font-semibold uppercase tracking-widest text-white/50">Today at the venue</p>
          <p class="mt-0.5 text-xs text-white/70">Live run sheet</p>
        </div>
        <span class="flex items-center gap-1.5 text-[0.55rem] uppercase tracking-widest text-emerald-300 font-semibold">
          <Activity className="w-3 h-3" />
          On track
        </span>
      </header>
      {todayEvents.map((event) => (
        <article data-fake-delete class="p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-sm font-semibold">{event.eventName}</p>
              <p class="mt-1 text-[0.65rem] text-white/55">{event.clientName}</p>
            </div>
            <span class="px-2 py-1 rounded bg-white/10 text-[0.55rem] font-semibold">
              {event.readiness}% ready
            </span>
          </div>
          <div class="mt-5 grid grid-cols-3 gap-3 text-[0.6rem] text-white/60">
            <span class="flex items-center gap-1.5">
              <Clock3 className="w-3 h-3" />
              {new Date(event.eventDate).toLocaleTimeString("en-US", { hour: "numeric", minute: "2-digit" })}
            </span>
            <span class="flex items-center gap-1.5">
              <MapPin className="w-3 h-3" />
              {event.assignedSpace}
            </span>
            <span class="flex items-center gap-1.5">
              <Users className="w-3 h-3" />
              {event.guestCount} guests
            </span>
          </div>
          <div class="mt-4 h-0.5 rounded-full bg-white/10 overflow-hidden">
            <div
              class="h-full bg-gradient-to-r from-sky-400 to-emerald-400 rounded-full"
              style={`width: ${event.readiness}%`}
            />
          </div>
          <div class="mt-4 border-t border-white/10 pt-3 flex items-center justify-between text-[0.6rem]">
            <span class="text-white/50">Coordinator</span>
            <span class="font-medium">{event.coordinator}</span>
          </div>
        </article>
      ))}
    </section>
  </div>

  <!-- Booking pipeline table -->
  <section class="bg-white border border-[#e5e7eb] rounded-xl shadow-sm overflow-hidden">
    <header class="px-4 py-3 flex items-center justify-between">
      <div>
        <p class="text-[0.6rem] font-semibold uppercase tracking-widest text-[#9ca3af]">Booking pipeline</p>
        <p class="mt-0.5 text-xs text-[#6b7280]">Latest confirmed and pending business</p>
      </div>
      <span class="text-[0.6rem] text-[#9ca3af]">Sample records</span>
    </header>
    <div class="overflow-x-auto">
      <table class="w-full min-w-170 text-left border-separate border-spacing-0">
        <thead class="bg-[#fafafa] text-[0.55rem] uppercase tracking-widest text-[#9ca3af]">
          <tr>
            <th class="px-4 py-2.5 font-semibold" style="border-bottom: 1px solid var(--admin-border);">Booking</th>
            <th class="px-4 py-2.5 font-semibold" style="border-bottom: 1px solid var(--admin-border);">Event</th>
            <th class="px-4 py-2.5 font-semibold" style="border-bottom: 1px solid var(--admin-border);">Date</th>
            <th class="px-4 py-2.5 font-semibold" style="border-bottom: 1px solid var(--admin-border);">Value</th>
            <th class="px-4 py-2.5 font-semibold" style="border-bottom: 1px solid var(--admin-border);">Payment</th>
          </tr>
        </thead>
        <tbody>
          {recentBookings.map((booking, i) => (
            <tr data-fake-delete class="hover:bg-[#fafafa]" style={i > 0 ? "border-top: 1px solid var(--admin-border);" : ""}>
              <td class="px-4 py-3">
                <p class="text-xs font-semibold text-[#111827]">{booking.clientName}</p>
                <p class="mt-0.5 text-[0.55rem] text-[#9ca3af]">{booking.accountNumber}</p>
              </td>
              <td class="px-4 py-3 text-xs text-[#6b7280]">{booking.eventName}</td>
              <td class="px-4 py-3 text-xs text-[#6b7280]">
                {new Date(booking.eventDate).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}
              </td>
              <td class="px-4 py-3 text-xs font-semibold text-[#111827]">${booking.revenue.toLocaleString()}</td>
              <td class="px-4 py-3">
                <span
                  class:list={[
                    "inline-flex px-2 py-1 rounded text-[0.55rem] font-semibold capitalize",
                    booking.paymentStatus === "paid"
                      ? "bg-emerald-50 text-emerald-700"
                      : booking.paymentStatus === "partial"
                        ? "bg-amber-50 text-amber-700"
                        : "bg-rose-50 text-rose-700",
                  ]}
                >
                  {booking.paymentStatus}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>

<script is:inline>
  // Demo only: "Delete" hides the row for 10 seconds, then it comes back. Nothing is deleted.
  document.querySelectorAll("[data-fake-delete]").forEach((el) => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.textContent = "Delete";
    btn.setAttribute("aria-label", "Delete (demo: it comes back in 10 seconds)");
    btn.className = "ml-auto shrink-0 text-xs font-medium text-red-600 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded";
    if (el.tagName === "TR") {
      const td = document.createElement("td");
      td.className = "px-4 py-3";
      td.appendChild(btn);
      el.appendChild(td);
    } else {
      el.appendChild(btn);
    }
    btn.addEventListener("click", () => {
      el.style.display = "none";
      setTimeout(() => { el.style.display = ""; }, 10000);
    });
  });
</script>
